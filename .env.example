# Copy to .env.local. Values come from `npx supabase status` (local) or
# your hosted project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional, dev only: to open the dev server from another device, add its
# host (comma-separated) and point NEXT_PUBLIC_SUPABASE_URL at this machine's
# IP instead of 127.0.0.1, since the browser calls Supabase directly.
# ALLOWED_DEV_ORIGINS=192.168.1.20
